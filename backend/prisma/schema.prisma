datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String              @id @default(uuid())
  email     String              @unique
  fullName  String              @map("full_name")
  role      String              @default("Warehouse")
  movements InventoryMovement[]

  @@map("users")
}

model Engineer {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  phone            String
  isActive         Boolean           @default(true) @map("is_active")
  materialRequests MaterialRequest[]

  @@map("engineers")
}

model MasterInstallation {
  id            String @id @default(uuid())
  applicationId String @unique @map("application_id")
  clientName    String @map("client_name")

  @@map("master_installations")
}

model Manufacturer {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("manufacturers")
}

model Part {
  id              String                  @id @default(uuid())
  code            String                  @unique
  description     String
  category        String?
  hpRating        String?                 @map("hp_rating")
  serialTracked   Boolean                 @default(true) @map("serial_tracked")
  valuationAmount Decimal                 @default(0.0) @map("valuation_amount")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @default(now()) @map("updated_at")
  movementLines   InventoryMovementLine[]

  @@map("parts")
}

model Warehouse {
  id        String              @id @default(uuid())
  name      String              @unique
  code      String              @default("JAL")
  stateCode String              @default("MH") @map("state_code")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @default(now()) @map("updated_at")
  movements InventoryMovement[]

  @@map("warehouses")
}

model UnitLedger {
  serialNo          String   @id @map("serial_no")
  partCode          String   @map("part_code")
  status            String // Fresh / Sent-to Farmer / Faulty-Received / At-Manufacturer / Repaired-Pending
  condition         String? // Repaired / New / Scrapped
  currentLocation   String?  @map("current_location") // Warehouse ID or Farmer App ID or Manufacturer Name
  linkedPriorSerial String?  @map("linked_prior_serial")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @map("updated_at")

  @@map("unit_ledger")
}

model InventoryMovement {
  id                String                  @id @default(uuid())
  warehouseId       String                  @map("warehouse_id")
  type              Int // 1 to 5 matching the cycle stage
  timestamp         DateTime                @default(now())
  partyName         String                  @map("party_name")
  referenceNumber   String                  @map("reference_number")
  vehicleNumber     String?                 @map("vehicle_number")
  reportedFault     String?                 @map("reported_fault")
  conditionReceived String?                 @map("condition_received")
  userId            String                  @map("user_id")
  materialRequestId String?                 @map("material_request_id")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @default(now()) @map("updated_at")
  warehouse         Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  user              User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  lines             InventoryMovementLine[]
  challans          Challan[]
  materialRequest   MaterialRequest?        @relation(fields: [materialRequestId], references: [id], onDelete: Restrict)

  @@map("inventory_movements")
}

model InventoryMovementLine {
  id            String                 @id @default(uuid())
  movementId    String                 @map("movement_id")
  partId        String                 @map("part_id")
  quantity      Int
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @default(now()) @map("updated_at")
  movement      InventoryMovement      @relation(fields: [movementId], references: [id], onDelete: Cascade)
  part          Part                   @relation(fields: [partId], references: [id], onDelete: Restrict)
  serialNumbers MovementSerialNumber[]

  @@map("inventory_movement_lines")
}

model MovementSerialNumber {
  id             String                @id @default(uuid())
  movementLineId String                @map("movement_line_id")
  serialNumber   String                @map("serial_number")
  createdAt      DateTime              @default(now()) @map("created_at")
  movementLine   InventoryMovementLine @relation(fields: [movementLineId], references: [id], onDelete: Cascade)

  @@map("movement_serial_numbers")
}

model Challan {
  id                 String            @id @default(uuid())
  challanNumber      String            @unique @map("challan_number")
  challanDate        DateTime          @default(now()) @map("challan_date")
  movementId         String            @map("movement_id")
  destinationName    String            @map("destination_name")
  destinationAddress String            @map("destination_address")
  destinationGst     String?           @map("destination_gst")
  destinationContact String?           @map("destination_contact")
  dispatchMode       String            @default("Transport") @map("dispatch_mode")
  purpose            String            @default("Repair & Replacement")
  remarks            String?
  preparedBy         String?           @map("prepared_by")
  totalAmount        Decimal           @default(0.0) @map("total_amount")
  gstRate            Decimal           @default(5.0) @map("gst_rate")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @default(now()) @map("updated_at")
  movement           InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@map("challans")
}

model Complaint {
  id            String    @id @default(uuid())
  applicationId String    @unique @map("application_id")
  ticketId      String    @unique @map("ticket_id")
  ticket        Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("complaints")
}

model Ticket {
  id               String            @id @default(uuid())
  complaint        Complaint?
  materialRequests MaterialRequest[]

  @@map("tickets")
}

model MaterialRequest {
  id        String              @id @default(uuid())
  ticketId  String              @map("ticket_id")
  ticket    Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  status    String              @default("PENDING") // PENDING, DISPATCHED
  items     Json                @default("[]")
  remarks   String?
  engineerId String?            @map("engineer_id")
  engineer  Engineer?           @relation(fields: [engineerId], references: [id], onDelete: SetNull)
  createdAt DateTime            @default(now()) @map("created_at")
  movements InventoryMovement[]

  @@map("material_requests")
}
